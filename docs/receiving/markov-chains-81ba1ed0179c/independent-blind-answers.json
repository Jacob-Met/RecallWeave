  "answer_count": 14,
  "answers": [
    {
      "id": "mc-rule",
      "option_index_zero_based": 0,
      "option_number_one_based": 1,
      "letter": "A",
      "answer_text": "Only the current state, through the same transition rule at every step.",
      "reason": "The Markov property removes dependence on the earlier path after conditioning on the current state; time homogeneity makes the transition rule independent of the step number.",
      "unique_justified_option": true
    },
    {
      "id": "mc-row",
      "option_index_zero_based": 2,
      "option_number_one_based": 3,
      "letter": "C",
      "answer_text": "Given that the current state is A, the modeled chance that the next state is B is 20%.",
      "reason": "The row is conditioned on the current state A and the middle column is next-state B. It is a conditional probability, not an exact finite count, time fraction, or reverse conditional.",
      "unique_justified_option": true
    },
    {
      "id": "mc-valid-row",
      "option_index_zero_based": 3,
      "option_number_one_based": 4,
      "letter": "D",
      "answer_text": "[0%, 35%, 65%]",
      "reason": "0%,35%,65% are nonnegative and sum to100%. The other rows respectively sum to110%, contain a negative entry, and sum to0%.",
      "unique_justified_option": true
    },
    {
      "id": "mc-mixture",
      "option_index_zero_based": 1,
      "option_number_one_based": 2,
      "letter": "B",
      "answer_text": "[50%,35%,15%]",
      "reason": "The next distribution is half of row A plus half of row B: [30+20,10+25,10+5]%=[50,35,15]%.",
      "unique_justified_option": true
    },
    {
      "id": "mc-two-steps",
      "option_index_zero_based": 0,
      "option_number_one_based": 1,
      "letter": "A",
      "answer_text": "[52%,24%,24%]",
      "reason": "Multiply [0.6,0.2,0.2] by P: A=0.36+0.08+0.08=0.52; B=0.12+0.10+0.02=0.24; C=0.12+0.02+0.10=0.24.",
      "unique_justified_option": true
    },
    {
      "id": "mc-path-versus-endpoint",
      "option_index_zero_based": 2,
      "option_number_one_based": 3,
      "letter": "C",
      "answer_text": "2%, obtained from 20% × 10%.",
      "reason": "The specified path has probability P(A,B)P(B,C)=0.2×0.1=0.02. Ending in C after two steps includes other intermediate states and has probability0.24.",
      "unique_justified_option": true
    },
    {
      "id": "mc-distribution-not-count",
      "option_index_zero_based": 3,
      "option_number_one_based": 4,
      "letter": "D",
      "answer_text": "The expected number in A at step 2 is 52, while the observed number can differ.",
      "reason": "The expected count is100×0.52=52. Independent copies have a binomial count with positive variance, so a particular experiment need not contain exactly52 in A.",
      "unique_justified_option": true
    },
    {
      "id": "mc-step-zero",
      "option_index_zero_based": 1,
      "option_number_one_based": 2,
      "letter": "B",
      "answer_text": "[20%,30%,50%], the initial distribution itself.",
      "reason": "No transition means multiplication by the identity matrix, so the initial distribution [20%,30%,50%] is displayed unchanged.",
      "unique_justified_option": true
    },
    {
      "id": "mc-stationary-test",
      "option_index_zero_based": 2,
      "option_number_one_based": 3,
      "letter": "C",
      "answer_text": "Multiplying once must give πP = π.",
      "reason": "For a probability row vector, one-step invariance πP=π is necessary and sufficient for stationarity under the fixed rule. Induction then gives πP^n=π.",
      "unique_justified_option": true
    },
    {
      "id": "mc-stationary-does-not-freeze",
      "option_index_zero_based": 1,
      "option_number_one_based": 2,
      "letter": "B",
      "answer_text": "It changes state with probability one, even though the overall distribution stays the same.",
      "reason": "Every diagonal entry is zero, so every possible individual transition changes state. Nevertheless [1/2,1/4,1/4]P=[1/2,1/4,1/4].",
      "unique_justified_option": true
    },
    {
      "id": "mc-alternation",
      "option_index_zero_based": 0,
      "option_number_one_based": 1,
      "letter": "A",
      "answer_text": "The probability of A is 100% at every even step and 0% at every odd step, so these distributions do not converge.",
      "reason": "From A the odd-step distribution is [0,1/2,1/2], and every following step returns all mass to A. The two distinct subsequences prevent convergence.",
      "unique_justified_option": true
    },
    {
      "id": "mc-mixing-conditions",
      "option_index_zero_based": 3,
      "option_number_one_based": 4,
      "letter": "D",
      "answer_text": "There is a unique stationary distribution, and distributions from any initial distribution approach it as the number of steps grows.",
      "reason": "In a finite chain, irreducibility gives a unique stationary distribution, and aperiodicity guarantees convergence to it from every initial distribution. The assumptions do not require uniform probabilities or exact finite sample proportions.",
      "unique_justified_option": true
    },
    {
      "id": "mc-absorbing",
      "option_index_zero_based": 1,
      "option_number_one_based": 2,
      "letter": "B",
      "answer_text": "A is absorbing: once the state is A, all later states remain A under this unchanged rule.",
      "reason": "The A row assigns all next-step mass to A. Repeated application keeps a path at A once it reaches A; the unspecified B and C rows give no additional global conclusion.",
      "unique_justified_option": true
    },
    {
      "id": "mc-closed-start",
      "option_index_zero_based": 2,
      "option_number_one_based": 3,
      "letter": "C",
      "answer_text": "After one step its distribution is [40%,60%,0%], which stays unchanged; starting certainly in A instead stays [100%,0%,0%].",
      "reason": "Starting in C moves the distribution to0.4δA+0.6δB in one step. A and B each absorb, so this mixture stays fixed; starting in A instead remains δA.",
      "unique_justified_option": true
    }
  ],
